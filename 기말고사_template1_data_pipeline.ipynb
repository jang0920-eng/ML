    "plt.show()\n",
    "\n",
    "# 3. Morgan Fingerprint 기반의 t-SNE 구조 유사도 공간 시각화\n",
    "fp_cols = [c for c in df_final.columns if c.startswith('Bit_')]\n",
    "X_fp = df_final[fp_cols]\n",
    "\n",
    "print(\"t-SNE 차원축소 변환 연산 진행 중 (수초가 소요됩니다)...\")\n",
    "tsne = TSNE(n_components=2, random_state=42, perplexity=30, n_iter=1000)\n",
    "X_tsne = tsne.fit_transform(X_fp)\n",
    "\n",
    "df_tsne = pd.DataFrame(X_tsne, columns=['t-SNE 1', 't-SNE 2'])\n",
    "df_tsne['label'] = df_final['label'].values\n",
    "\n",
    "plt.figure(figsize=(10, 8))\n",
    "sns.scatterplot(data=df_tsne, x='t-SNE 1', y='t-SNE 2', hue='label', \n",
    "                palette=colors, alpha=0.6, style='label')\n",
    "plt.title('t-SNE 기반 분자 구조적 유사성 공간 시각화', fontsize=13, weight='bold')\n",
